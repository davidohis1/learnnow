; Production recommendations. Merge into your PHP-FPM/Apache configuration.
display_errors = Off
log_errors = On
expose_php = Off
file_uploads = On
upload_max_filesize = 5M
post_max_size = 6M
max_file_uploads = 5
max_execution_time = 30
memory_limit = 256M
date.timezone = UTC
cgi.fix_pathinfo = 0
; Configure a private OS-managed PHP error_log and its rotation policy.
